// Prep Coach v2 data model.
// Two halves: better-auth's tables (User/Session/Account/Verification — shapes
// come from the better-auth docs, IDs generated by the library) and our domain
// tables, every one scoped to a user. Zero seeded rows anywhere by design.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- better-auth ----------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  profile   Profile?
  recipes   Recipe[]
  staples   Staple[]
  weeks     Week[]
  foodLog   FoodLogEntry[]
  weightLog WeightEntry[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // scrypt hash, managed by better-auth
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ---------- Prep Coach domain ----------

enum GoalType {
  lose
  gain
  maintain
  eat_cleaner
}

enum ActivityLevel {
  sedentary
  light
  moderate
  very
  extra
}

// Everything nullable: a brand-new profile is a row of nothing. The app only
// shows targets/judgment where the user has actually set numbers.
model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalType         GoalType?
  sex              String? // "male" | "female" (for BMR math only)
  age              Int?
  heightIn         Int?
  weightLb         Int?
  goalWeightLb     Int?
  activityLevel    ActivityLevel?
  weeklyKcalBudget Int? // the "bank" — saved only when the user confirms it
  proteinLowGDay   Int?
  proteinHighGDay  Int?
  aboutMe          String    @default("")
  onboardedAt      DateTime? // null → app routes the user into onboarding

  // Maintenance (BMR + NEAT), the number deficits are measured against.
  // NULL means "work it out for me": the app derives it from the scale and
  // the diary. Set it and that pin wins. The weekly bank never moves on its own.
  maintenanceKcal   Int?
  // How far off the bank a week can land and still read as "on target".
  bankToleranceKcal Int @default(500)
}

// A weigh-in. One per day — saving the same date again replaces it, so a
// re-weigh corrects rather than duplicates. Float because scales read tenths;
// no money here, so integer-cents discipline doesn't apply.
model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  weightLb  Float
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

enum Slot {
  main
  breakfast
  snack
  shake
  simple_lunch
}

model Recipe {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  source         String    @default("")
  servings       Int       @default(4)
  kcalPerServing Int       @default(0)
  proteinG       Int       @default(0) // per serving
  carbsG         Int       @default(0)
  fatG           Int       @default(0)
  slot           Slot      @default(main)
  keeper         Boolean? // null = unrated, true = keeper, false = retired
  timesMade      Int       @default(0)
  lastMade       DateTime?
  createdAt      DateTime  @default(now())
  rawText        String    @default("") // the original paste — never lost
  notes          String    @default("")

  ingredients Ingredient[]
  weekRecipes WeekRecipe[]

  @@index([userId])
}

model Ingredient {
  id         String  @id @default(cuid())
  recipeId   String
  recipe     Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name       String
  qty        Float? // null = "to taste"
  unit       String  @default("")
  department String  @default("Other")
  // Claude's guess that this is a keep-on-hand item (salt, oil). Used ONLY to
  // sort the shopping review "likely need" first — never to remove anything.
  stapleHint Boolean @default(false)
  sortOrder  Int     @default(0)
}

enum FoodKind {
  grocery // bought at the store: joins the week plan and the shopping list
  quick_eat // takeout or no-prep: logged straight to the diary, never shopped
}

// The "Staples & Quick Eats" library. Two kinds of non-recipe calories:
// groceries you buy every week (jerky, shakes, iced tea) and quick eats you
// just eat (a Chipotle bowl). Both are one-tap loggable on Track; only
// groceries flow into week planning and the shopping list.
// (Model is still named Staple for its table history — `kind` is the truth.)
model Staple {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  kind        FoodKind @default(grocery)
  kcal        Int?
  proteinG    Int?
  carbsG      Int?
  fatG        Int?
  servingNote String   @default("") // "1 bowl: chicken, rice, black beans"
  defaultQty  Int      @default(1) // groceries only: usual qty per week
  department  String   @default("Other") // groceries only: aisle for the list
  createdAt   DateTime @default(now())

  weekStaples WeekStaple[]

  @@index([userId])
}

enum WeekStatus {
  planning
  shopping
  cooking
  done
}

model Week {
  id     String     @id @default(cuid())
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekOf DateTime   @db.Date
  status WeekStatus @default(planning)

  // Copied from the profile at creation so a finished week keeps its numbers
  // even if the user later changes their targets. Null = no target set.
  // budgetKcal is already PRORATED for dayCount — a 5-day week banks 5/7ths.
  budgetKcal      Int?
  proteinLowGDay  Int?
  proteinHighGDay Int?
  dayCount        Int  @default(7) // 1-7; < 7 when you start mid-week

  createdAt       DateTime  @default(now())
  listBuiltAt     DateTime?
  listFinalizedAt DateTime?

  recipes      WeekRecipe[]
  staples      WeekStaple[]
  listItems    ShoppingListItem[]
  chatMessages ChatMessage[]

  @@index([userId, status])
}

model WeekRecipe {
  id       String @id @default(cuid())
  weekId   String
  week     Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id])
  portions Int

  @@unique([weekId, recipeId])
}

// Snapshot copy of a staple as picked for one week — a done week's numbers
// never change retroactively, even if the library entry is edited or deleted.
model WeekStaple {
  id         String  @id @default(cuid())
  weekId     String
  week       Week    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  stapleId   String?
  staple     Staple? @relation(fields: [stapleId], references: [id], onDelete: SetNull)
  name       String
  kcal       Int?
  proteinG   Int?
  department String  @default("Other")
  qty        Int     @default(1)
}

enum ItemStatus {
  unreviewed
  have
  need
}

// These rows ARE the shopping list snapshot — value copies, not references.
model ShoppingListItem {
  id         String     @id @default(cuid())
  weekId     String
  week       Week       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  name       String
  qty        Float?
  unit       String     @default("")
  department String     @default("Other")
  sources    String[]   @default([])
  likelyHave Boolean    @default(false) // sorts review order only; user decides
  status     ItemStatus @default(unreviewed)
  sortOrder  Int        @default(0)

  @@index([weekId])
}

enum ChatRole {
  user
  assistant
}

model ChatMessage {
  id        String   @id @default(cuid())
  weekId    String
  week      Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  @@index([weekId, createdAt])
}

enum EntrySource {
  manual
  advisor
}

// Food diary: one row per thing eaten. Belongs to the USER and a DATE — never
// to a week. A plan is just a plan: you can track every day whether or not a
// week has been planned, and re-dating a plan never orphans what you ate.
// Weeks read the log by date range for their math.
model FoodLogEntry {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime    @db.Date
  description String
  kcal        Int
  proteinG    Int?
  carbsG      Int?
  fatG        Int?
  source      EntrySource @default(manual)
  createdAt   DateTime    @default(now())

  @@index([userId, date])
}
